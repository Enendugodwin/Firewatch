# ---------------------------------------------------------------------------
# FIREWATCH X â€” environment template
# Copy to `.env` at the repository root and fill in the values you have.
# Never commit `.env`. Secrets stay on the backend only.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# Frontend origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273

# --- deployment profiles ----------------------------------------------------
# local | hybrid | cloud. Only configuration changes between them.
DEPLOYMENT_MODE=local
# local | r2 | s3
STORAGE_MODE=local
# local | cloud | split
DATABASE_MODE=local
LOCAL_DATA_DIRECTORY=./data
CLOUD_DATABASE_URL=

# Cloudflare R2 (S3-compatible). Leave empty for local-only operation.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ALLOCATION_BYTES=26843545600

# --- database --------------------------------------------------------------
# Leave DATABASE_URL unset for local development with no database server: the
# API then uses a SQLite file (no PostGIS, spatial capability reports false).
# `docker compose up` injects its own PostgreSQL URL, so this file is not used
# by the containers.
#
# Real deployments (PostgreSQL 16 + PostGIS):
# DATABASE_URL=postgresql+psycopg://firewatch:change-me@localhost:5433/firewatch
#
# DATABASE_URL=sqlite+pysqlite:///./firewatch.db
# Bulk ingestion windows can exceed the 60 s interactive statement cap.
# Applied with SET LOCAL for the ingest transaction; 0 disables the limit.
INGESTION_STATEMENT_TIMEOUT_MS=900000
DATABASE_ECHO=false

# Used by docker-compose to create the database container.
# Per-client API rate limit; 0 disables the limiter (default).
RATE_LIMIT_PER_MINUTE=0

POSTGRES_USER=firewatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=firewatch
POSTGRES_PORT=5433

# --- cache / queues --------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
REDIS_PORT=6380

# --- NASA FIRMS (required for any real observation) ------------------------
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# NEVER paste a real key into this template: .env.example is committed to git.
# Put the key in .env (git-ignored) or a secret manager instead.
FIRMS_MAP_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
FIRMS_REQUEST_TIMEOUT=60
FIRMS_MAX_RETRIES=4

# --- object storage (reports and raw archives, optional) -------------------
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=firewatch-data
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- AI assistant (optional; statistical intelligence works without it) ----
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- container ports -------------------------------------------------------
API_PORT=8200
WEB_PORT=8088
